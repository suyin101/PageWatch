# 复制一份改名为 .env，再按需修改。修改后需要重启。

# 网页访问端口
PORT=3600

# 管理员账号（可选）。不填的话，第一次打开网页时让你自己创建。
# 部署到服务器时建议填上，避免在你创建账号之前被别人抢先创建。
# 账号创建好以后这两行就不起作用了，改密码请到网页里的「设置 → 账号安全」。
ADMIN_USER=
ADMIN_PASSWORD=

# 面板的访问地址（可选）。填了以后，通知里会多一个“打开监测面板”按钮，模板里也能用 {{面板地址}}
PUBLIC_URL=

# 数据保存目录（可选），默认是项目里的 data 文件夹
# DATA_DIR=/www/wwwroot/pagewatch-data
